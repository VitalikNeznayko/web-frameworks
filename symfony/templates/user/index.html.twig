{% extends 'base.html.twig' %}

{% block title %}Користувачі{% endblock %}

{% block body %}
    <div class="card">
        <h1>Користувачі</h1>
        {% include '_filter_form.html.twig' %}
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Повне ім'я</th>
                    <th>Email</th>
                    <th>Роль</th>
                    <th>Створено</th>
                    <th>Дії</th>
                </tr>
            </thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.fullName }}{% if app.user.id == user.id %} <span class="muted">(ви)</span>{% endif %}</td>
                    <td>{{ user.email }}</td>
                    <td><span class="badge badge-role badge-{{ user.role|lower }}">{{ user.roleLabel }}</span></td>
                    <td>{{ user.createdAt|date('d.m.Y H:i') }}</td>
                    <td>
                        <a href="{{ path('user_show', {'id': user.id}) }}">переглянути</a>
                        | <a href="{{ path('user_edit', {'id': user.id}) }}">редагувати</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="muted">Записів не знайдено</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {% include '_pagination.html.twig' %}
        <div class="actions">
            <a class="btn" href="{{ path('user_new') }}">Додати користувача</a>
        </div>
    </div>
{% endblock %}
