{% extends 'base.html.twig' %}

{% block title %}Бронювання #{{ booking.id }}{% endblock %}

{% block body %}
    <div class="card">
        <h1>Бронювання #{{ booking.id }}</h1>
        <dl class="details">
            <dt>Гість</dt><dd><a href="{{ path('guest_show', {'id': booking.guest.id}) }}">{{ booking.guest }}</a></dd>
            <dt>Ліжко</dt><dd><a href="{{ path('bed_show', {'id': booking.bed.id}) }}">{{ booking.bed }}</a> ({{ booking.bed.bedTypeLabel }})</dd>
            <dt>Заїзд</dt><dd>{{ booking.checkIn|date('d.m.Y') }}</dd>
            <dt>Виїзд</dt><dd>{{ booking.checkOut|date('d.m.Y') }}</dd>
            <dt>Ночей</dt><dd>{{ booking.nights }}</dd>
            <dt>Статус</dt><dd><span class="badge">{{ booking.statusLabel }}</span></dd>
            <dt>Загальна вартість</dt><dd>{{ booking.totalPrice|number_format(2, '.', ' ') }} грн</dd>
            <dt>Сплачено</dt><dd>{{ booking.paidAmount|number_format(2, '.', ' ') }} грн</dd>
            <dt>Примітки</dt><dd>{{ booking.notes ?: '—' }}</dd>
            <dt>Створено</dt><dd>{{ booking.createdAt|date('d.m.Y H:i') }}</dd>
        </dl>

        <h2>Платежі</h2>
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Сума</th>
                    <th>Спосіб</th>
                    <th>Статус</th>
                    <th>Дата оплати</th>
                </tr>
            </thead>
            <tbody>
            {% for payment in booking.payments %}
                <tr>
                    <td><a href="{{ path('payment_show', {'id': payment.id}) }}">#{{ payment.id }}</a></td>
                    <td>{{ payment.amount|number_format(2, '.', ' ') }} грн</td>
                    <td>{{ payment.methodLabel }}</td>
                    <td><span class="badge">{{ payment.statusLabel }}</span></td>
                    <td>{{ payment.paidAt ? payment.paidAt|date('d.m.Y H:i') : '—' }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="muted">Платежів немає</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <div class="actions">
            <a class="btn btn-secondary" href="{{ path('booking_index') }}">До списку</a>
            <a class="btn" href="{{ path('booking_edit', {'id': booking.id}) }}">Редагувати</a>
            <a class="btn" href="{{ path('payment_new') }}">Додати платіж</a>
            {{ include('booking/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
