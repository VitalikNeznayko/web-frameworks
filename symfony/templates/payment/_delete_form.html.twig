<form method="post" action="{{ path('payment_delete', {'id': payment.id}) }}" onsubmit="return confirm('Ви впевнені, що хочете видалити цей запис?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ payment.id) }}">
    <button class="btn btn-danger">Видалити</button>
</form>
