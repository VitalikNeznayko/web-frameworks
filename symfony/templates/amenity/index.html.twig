{% extends 'base.html.twig' %}

{% block title %}Зручності{% endblock %}

{% block body %}
    <div class="card">
        <h1>Зручності</h1>
        {% include '_filter_form.html.twig' %}
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Назва</th>
                    <th>Опис</th>
                    <th>Кімнат</th>
                    <th>Дії</th>
                </tr>
            </thead>
            <tbody>
            {% for amenity in amenities %}
                <tr>
                    <td>{{ amenity.id }}</td>
                    <td>{{ amenity.name }}</td>
                    <td>{{ amenity.description ?: '—' }}</td>
                    <td>{{ amenity.rooms|length }}</td>
                    <td>
                        <a href="{{ path('amenity_show', {'id': amenity.id}) }}">переглянути</a>
                        {% if is_granted('ROLE_MANAGER') %}| <a href="{{ path('amenity_edit', {'id': amenity.id}) }}">редагувати</a>{% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="muted">Записів не знайдено</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {% include '_pagination.html.twig' %}
        <div class="actions">
            {% if is_granted('ROLE_MANAGER') %}
                <a class="btn" href="{{ path('amenity_new') }}">Додати зручність</a>
            {% endif %}
        </div>
    </div>
{% endblock %}
