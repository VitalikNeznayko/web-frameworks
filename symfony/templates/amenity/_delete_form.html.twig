<form method="post" action="{{ path('amenity_delete', {'id': amenity.id}) }}" onsubmit="return confirm('Ви впевнені, що хочете видалити цей запис?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ amenity.id) }}">
    <button class="btn btn-danger">Видалити</button>
</form>
