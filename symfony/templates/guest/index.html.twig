{% extends 'base.html.twig' %}

{% block title %}Гості{% endblock %}

{% block body %}
    <div class="card">
        <h1>Гості</h1>
        {% include '_filter_form.html.twig' %}
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Ім'я</th>
                    <th>Email</th>
                    <th>Телефон</th>
                    <th>Країна</th>
                    <th>Бронювань</th>
                    <th>Дії</th>
                </tr>
            </thead>
            <tbody>
            {% for guest in guests %}
                <tr>
                    <td>{{ guest.id }}</td>
                    <td>{{ guest.fullName }}</td>
                    <td>{{ guest.email }}</td>
                    <td>{{ guest.phone }}</td>
                    <td>{{ guest.country }}</td>
                    <td>{{ guest.bookings|length }}</td>
                    <td>
                        <a href="{{ path('guest_show', {'id': guest.id}) }}">переглянути</a>
                        | <a href="{{ path('guest_edit', {'id': guest.id}) }}">редагувати</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="muted">Записів не знайдено</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {% include '_pagination.html.twig' %}
        <div class="actions">
            <a class="btn" href="{{ path('guest_new') }}">Додати гостя</a>
        </div>
    </div>
{% endblock %}
