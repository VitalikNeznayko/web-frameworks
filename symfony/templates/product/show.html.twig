{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}
    <h1>{{ product.name }}</h1>

    <table border="1" cellpadding="6">
        <tr><th>ID</th><td>{{ product.id }}</td></tr>
        <tr><th>Назва</th><td>{{ product.name }}</td></tr>
        <tr><th>Опис</th><td>{{ product.description }}</td></tr>
        <tr><th>Ціна</th><td>{{ product.price }} грн</td></tr>
    </table>

    <a href="{{ path('product_edit', {id: product.id}) }}">Редагувати</a>
    {{ include('product/_delete_form.html.twig') }}
    <a href="{{ path('product_index') }}">Назад до списку</a>
{% endblock %}
